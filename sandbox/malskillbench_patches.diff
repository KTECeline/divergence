+import shutil
 import subprocess
 import sys
 import tempfile
@@ -16,7 +17,33 @@ from typing import Dict, List, Tuple
 
 DOCKER_IMAGE = "malskillbench/verification-sandbox"
 DOCKER_DIR = Path(__file__).parent / "docker"
+# NOTE (patched): isolation for running malicious skills inside the dvg-lab VM.
+# Upstream used --network host and passed the LLM API key into the container.
+# Containers now join an --internal Docker network whose only reachable hosts
+# are INetSim (fake internet), a dnsmasq DNS sinkhole, and an egress proxy that
+# injects the real key, so the key never enters the container.
+# See Divergence/sandbox/setup_notes.md (Steps D-G).
+SANDBOX_NETWORK = os.environ.get("DVG_SANDBOX_NETWORK", "dvg-isolated")
+SANDBOX_DNS = os.environ.get("DVG_SANDBOX_DNS", "172.30.0.4")
+CONTAINER_API_KEY = "injected-by-proxy"
+# NOTE (patched): upstream wrote each run's evidence into <skill_dir>/_runtime/
+# and mounted the whole skill_dir into the next container, so the agent could
+# read the previous run's trigger, output and logs (seen in the 12306 smoke
+# test). The container now gets a clean copy without these bookkeeping files,
+# and runtime logs are kept outside the dataset.
+NON_SKILL_FILES = {
+    "_meta.json", "_runtime", "_evidence.json", "_agent_raw.jsonl",
+    # Generation-time labels (expected behaviour, IOCs, provenance): would hand
+    # the agent the answer key if a skill folder ever contained them.
+    "_expected.json", "_indicators.json", "_provenance.json",
+}
+if SANDBOX_NETWORK in ("host", "bridge", "default"):
+    raise RuntimeError(
+        f"Refusing to run skills on Docker network '{SANDBOX_NETWORK}': "
+        "it has internet access. Use the --internal network (dvg-isolated)."
+    )
 PROJECT_ROOT = Path(__file__).parent.parent.parent
+RUNTIME_LOG_ROOT = PROJECT_ROOT / "Logs" / "runtime"  # see NON_SKILL_FILES note
 # Evidence scratch lives on the project disk (/home2 / sdb), NOT /tmp (sda).
 # Strace logs run 10-100 MB per skill; writing them to the system disk
 # contends with SSH/pty/other-users' home I/O and visibly degrades responsiveness.
@@ -181,6 +208,20 @@ class DockerSandbox:
         ) as tmp_dir:
             tmp_evidence = Path(tmp_dir) / "evidence"
             tmp_evidence.mkdir()
+            # Container root runs with --cap-drop ALL (no CAP_DAC_OVERRIDE), so
+            # it can only write here if the directory is world-writable.
+            tmp_evidence.chmod(0o777)
+            clean_skill = Path(tmp_dir) / "skill"
+            shutil.copytree(
+                skill_dir, clean_skill,
+                ignore=lambda d, names: (
+                    [n for n in names if n in NON_SKILL_FILES]
+                    + [n for n in names if n.startswith("._") or n == ".DS_Store"]
+                    if Path(d) == skill_dir
+                    # macOS metadata files (AppleDouble, Finder) at any depth
+                    else [n for n in names if n.startswith("._") or n == ".DS_Store"]
+                ),
+            )
             safe_name = re.sub(r"[^a-zA-Z0-9_.-]", "_", skill_dir.name)
             container_name = f"malskillbench_verify_{safe_name}"[:63]
 
