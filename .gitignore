# ---- Python ----
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/

# ---- Virtual environments ----
.venv/
.venv-agt/
venv/
env/
.venv/bin/

# ---- Testing / tooling caches ----
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# ---- Jupyter ----
.ipynb_checkpoints/

# ---- Secrets / local config ----
.env
.env.*
!.env.example

# ---- Data (not committed — see README; keep folder READMEs) ----
data/**
!data/**/
!data/**/README.md
!data/**/.gitkeep

# ---- Vendored third-party repos (cloned separately; MalSkillBench is ~1GB with its own .git) ----
vendor/MalSkillBench/
vendor/*_result.json

# ---- Trained models (regenerated by the pipeline) ----
models/**
!models/**/
!models/**/README.md
!models/**/.gitkeep

# ---- Experiment outputs (figures are kept for the report) ----
results/**/*.csv
results/**/*.json
results/**/*.pkl
results/**/*.log

# ---- graphify ----
graphify-out/

# ---- OS / editor ----
.DS_Store
.idea/
.vscode/
*.swp
